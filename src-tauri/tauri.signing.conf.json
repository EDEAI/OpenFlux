{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "signCommand": {
        "cmd": "artifact-signing-cli",
        "args": [
          "-e",
          "https://eus.codesigning.azure.net",
          "-a",
          "openflux",
          "-c",
          "OpenFlux-Production",
          "-d",
