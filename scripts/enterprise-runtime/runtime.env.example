# OpenFlux Enterprise Runtime 环境文件
# 复制为 %ProgramData%\NexusAI\enterprise-runtime\runtime.env（Windows）
# 或 /etc/nexusai/enterprise-runtime.env（Linux），并填入真实值。
# 令牌只放在这个文件里，不要写进 Git、文档或计划任务参数。

# ---- NexusAI OS ----
NEXUSAI_OS_URL=http://127.0.0.1:9480
NEXUSAI_OS_RUNTIME_ENROLLMENT_TOKEN=
NEXUSAI_TENANT_ID=team:1
# 必须与已冻结计划中的 preferred_runtime_id 一致
NEXUSAI_ENTERPRISE_RUNTIME_ID=openflux-enterprise-runtime-local-1

# ---- NexusAI Studio（托管模型接口）----
NEXUSAI_STUDIO_URL=http://127.0.0.1:9472
NEXUSAI_ENTERPRISE_RUNTIME_SERVICE_TOKEN=

# ---- 工作区与代码库登记 ----
# Windows 路径在 JSON 里要写成 \\；只有这里登记的代码库会出现在 Studio 的需求编辑器中
NEXUSAI_ENTERPRISE_WORKTREE_ROOT=D:\edeProject\.openflux-enterprise-runtime\worktrees
NEXUSAI_ENTERPRISE_REPOSITORIES_JSON=[{"repository_ref":"NexusAI","repository_path":"D:\\edeProject\\NexusAI","base_ref":"HEAD"}]

# ---- 常驻循环 ----
# 空闲时拉取间隔；OS 不可用时从 INITIAL 指数退避到 MAX
NEXUSAI_ENTERPRISE_POLL_MS=2000
NEXUSAI_ENTERPRISE_RECONNECT_INITIAL_MS=1000
NEXUSAI_ENTERPRISE_RECONNECT_MAX_MS=30000
# 设为 1 时只处理一轮就退出（用于冒烟验证）
# NEXUSAI_ENTERPRISE_RUN_ONCE=1

# ---- 单任务预算 ----
NEXUSAI_ENTERPRISE_MAX_ITERATIONS=16
NEXUSAI_ENTERPRISE_MAX_TOOL_CALLS=32
NEXUSAI_ENTERPRISE_COMMAND_TIMEOUT_MS=120000
